<body>
    <div class="error-container">
        <div class="error-card">
            <?php
            $errorCode = $error['code'] ?? 500;
            $errorMessage = $error['message'] ?? 'Une erreur est survenue';
            
            // Icônes et couleurs selon le code d'erreur
            switch ($errorCode) {
                case 404:
                    $iconClass = 'bi-search';
                    $iconColor = '#f59e0b';
                    $title = 'Page introuvable';
                    $suggestion = 'La page que vous recherchez n\'existe pas ou a été déplacée.';
                    break;
                case 403:
                    $iconClass = 'bi-shield-exclamation';
                    $iconColor = '#ef4444';
                    $title = 'Accès refusé';
                    $suggestion = 'Vous n\'avez pas les permissions nécessaires pour accéder à cette ressource.';
                    break;
                case 400:
                    $iconClass = 'bi-exclamation-triangle';
                    $iconColor = '#f59e0b';
                    $title = 'Requête invalide';
                    $suggestion = 'Les données transmises sont incorrectes ou incomplètes.';
                    break;
                default:
                    $iconClass = 'bi-exclamation-triangle-fill';
                    $iconColor = '#dc3545';
                    $title = 'Erreur technique';
                    $suggestion = 'Une erreur technique temporaire empêche le bon fonctionnement du service.';
                    break;
            }
            ?>
            
            <i class="bi <?= $iconClass ?> error-icon" style="color: <?= $iconColor ?>"></i>
            <h1 class="error-title"><?= htmlspecialchars($title) ?></h1>
            <p class="error-message">
                <?= htmlspecialchars($errorMessage) ?>
            </p>
            
            <?php if ($errorCode !== 400): // Pas de suggestion pour erreur validation ?>
            <p class="text-muted small">
                <?= htmlspecialchars($suggestion) ?>
            </p>
            <?php endif; ?>
            
            <div class="error-actions">
                <a href="index.php" class="btn-home">
                    <i class="bi bi-house-fill me-2"></i>
                    Retour au catalogue
                </a>
                <button onclick="history.back()" class="btn-back">
                    <i class="bi bi-arrow-left me-2"></i>
                    Retour
                </button>
            </div>
            
            <!-- Informations de debug en développement -->
            <?php if (($config['app']['debug'] ?? false) && isset($_SERVER)): ?>
            <div class="error-details">
                <strong>Informations de debug:</strong><br>
                <small>
                    URL: <?= htmlspecialchars($_SERVER['REQUEST_URI'] ?? 'N/A') ?><br>
                    Méthode: <?= htmlspecialchars($_SERVER['REQUEST_METHOD'] ?? 'N/A') ?><br>
                    User Agent: <?= htmlspecialchars(substr($_SERVER['HTTP_USER_AGENT'] ?? 'N/A', 0, 100)) ?><br>
                    Timestamp: <?= date('Y-m-d H:i:s') ?>
                </small>
            </div>
            <?php endif; ?>
        </div>
    </div>

    <script>
        // Auto-retry après 30 secondes pour erreurs 500
        <?php if ($errorCode >= 500): ?>
        let retryCount = 0;
        const maxRetries = 3;
        
        function autoRetry() {
            if (retryCount < maxRetries) {
                retryCount++;
                setTimeout(() => {
                    console.log(`Tentative de rechargement automatique ${retryCount}/${maxRetries}`);
                    window.location.reload();
                }, 30000);
            }
        }
        
        // Démarrer le retry automatique
        autoRetry();
        <?php endif; ?>
        
        // Raccourci clavier pour retour rapide
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                history.back();
            } else if (e.key === 'Home' || (e.ctrlKey && e.key === 'h')) {
                window.location.href = 'index.php';
            }
        });
        
        // Message de statut pour les lecteurs d'écran
        if (<?= $errorCode ?> >= 500) {
            const statusElement = document.createElement('div');
            statusElement.setAttribute('aria-live', 'polite');
            statusElement.setAttribute('aria-atomic', 'true');
            statusElement.className = 'visually-hidden';
            statusElement.textContent = 'Erreur technique détectée. Rechargement automatique dans 30 secondes.';
            document.body.appendChild(statusElement);
        }
    </script>
</body>
</html>